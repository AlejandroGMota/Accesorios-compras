rules_version = '2';

// ===========================================================================
// VERSIÓN DEL ARCHIVO: 3  ·  2026-10-09
//
// ⚠️ El `rules_version = '2'` de arriba NO es esta versión. Esa es la del
// lenguaje de reglas de Firestore y solo acepta '1' o '2': si se cambia por
// un 2.1 o parecido, la consola rechaza el archivo entero al publicarlo.
// El seguimiento de nuestros cambios vive aquí abajo.
//
//   3 · 2026-10-09 — se agregan `hidrogel_conteos` (conteo físico de cada
//       hoja, que el panel toma como punto de partida en vez de dar por hecho
//       que no quedaba nada al llegar cada pedido) y `hidrogel_compras` (Blue
//       Ray y Tablet 13", que no se piden a KASR). Las dos solo se crean: un
//       conteo o una compra mal capturados se corrigen con un conteo nuevo, y
//       así queda rastro de los dos.
//   2 · 2026-09-29 (e89d1f7) — se agregan `fundas_compras`, `compras` (el
//       resto de categorías, con campo `categoria`) y `fundas_ventas`. En
//       ventas el borrado queda prohibido: una venta mal capturada se marca
//       `anulada`, que es reversible; borrarla no lo es.
//   1 · 2026-09-28 (fb719b1) — primera versión versionada en el repo. Quién
//       es admin pasa a decidirse por la colección `admins/{uid}` en vez de
//       un correo escrito aquí dentro, y entran `items` y `locales`.
//
// Al cambiar algo: subir el número, anotar qué y por qué, y **volver a
// publicar en la consola**. Editar el archivo no surte ningún efecto solo.
// ===========================================================================

// Reglas de Firestore de accesories.alejandrogmota.com
//
// Hasta ahora vivían solo en la consola de Firebase y estaban en
// `allow read, write: if true`. Aquí quedan versionadas, pero OJO: este
// archivo no se publica solo. Hay que pegarlo en la consola
// (Firestore Database → Rules → Publicar) para que surta efecto.
//
// Criterio actual: las listas quedan abiertas, porque la gente de cada local
// anota sin cuenta. Lo único que pide sesión es administrar locales.
// Eso significa que los datos siguen siendo legibles por quien conozca el
// proyecto: el login de admin y de la lista global esconde la pantalla, no
// los datos. Cerrarlos de verdad pide login (aunque sea anónimo) en las
// listas de local.

service cloud.firestore {
  match /databases/{database}/documents {

    // Quién administra se decide por la colección `admins`: un documento vacío
    // por cada UID autorizado, creado a mano desde la consola. Así no hay
    // ningún correo ni identificador dentro del repo, que es público, y dar o
    // quitar permiso no obliga a volver a publicar las reglas.
    function esAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // La lista de administradores se gestiona solo desde la consola. Cada quien
    // puede consultar si es admin, para que el panel avise en vez de fallar
    // callado al guardar.
    match /admins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Productos por comprar. Los anota quien esté en el local, sin cuenta.
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Los locales los lee cualquiera (las listas necesitan su nombre),
    // pero crearlos, renombrarlos y borrarlos es solo tuyo.
    match /locales/{localId} {
      allow read:  if true;
      allow write: if esAdmin();
    }

    // Historial de compras de micas: lo escribe la lista al agregar y palomear
    match /micas_compras/{docId} {
      allow read, write: if true;
    }

    // Historial de compras de fundas. Mismo criterio que micas_compras: lo
    // escribe la lista del local, que no tiene cuenta.
    match /fundas_compras/{docId} {
      allow read, write: if true;
    }

    // Historial de todo lo demás (Hidrogel, Fundas nuevas, 1hora, Refacciones,
    // Otros) en una sola colección, con el campo `categoria` diciendo de cuál
    // es. El documento es idéntico en todas y ninguna tiene análisis propio,
    // así que Analytics las lee de un tirón en vez de con una consulta por
    // categoría.
    match /compras/{docId} {
      allow read, write: if true;
    }

    // Ventas de fundas, desde `venta.html`. Las registra quien atiende el
    // local, que tampoco tiene cuenta, así que se escribe abierto como el
    // resto. Una venta mal capturada no se borra: se marca `anulada`, y por eso
    // el borrado sí queda prohibido — es lo único irreversible.
    match /fundas_ventas/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Documento viejo de la lista (respaldo) y bandera de la migración
    match /app/{docId} {
      allow read, write: if true;
    }

    // Hidrogel. El conector escribe con cuenta de servicio, que se salta
    // estas reglas; esto es para que la pestaña de Analytics pueda leer.
    match /hidrogel_ventas/{docId} {
      allow read, write: if true;
    }

    match /hidrogel_pedidos/{docId} {
      allow read, write: if true;
    }

    match /hidrogel_conteos/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /hidrogel_compras/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
